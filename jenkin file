pipeline {
    agent any

    environment {
        SSH_CRED = 'node'
        SERVER_IP = '172.31.15.107'
        REMOTE_USER = 'ubuntu'
        WEB_DIR = '/var/www/html'
    }

    stages {
        stage('Clone Repo') {
            steps {
                git url: 'https://github.com/IAMRADHA/devops-portfolio.git',
                    branch: 'main'
            }
        }

        stage('Prepare EC2 Server') {
            steps {
                sshagent(credentials: ["${SSH_CRED}"]) {
                    sh '''
                        ssh -o StrictHostKeyChecking=no ${REMOTE_USER}@${SERVER_IP} '
                            if ! command -v apache2 >/dev/null 2>&1; then
                                sudo apt-get update
                                sudo apt-get install -y apache2
                            fi

                            sudo mkdir -p /var/www/html
                            sudo systemctl enable --now apache2
                        '
                    '''
                }
            }
        }

        stage('Deploy to Apache Server') {
            steps {
                sshagent(credentials: ["${SSH_CRED}"]) {
                    sh '''
                        echo "Uploading website files..."

                        scp -o StrictHostKeyChecking=no \
                            index.html style.css script.js resume.pdf \
                            ${REMOTE_USER}@${SERVER_IP}:/tmp/

                        scp -o StrictHostKeyChecking=no -r \
                            images ${REMOTE_USER}@${SERVER_IP}:/tmp/

                        echo "Deploying website..."

                        ssh -o StrictHostKeyChecking=no \
                            ${REMOTE_USER}@${SERVER_IP} '
                                sudo cp /tmp/index.html /tmp/style.css \
                                    /tmp/script.js /tmp/resume.pdf /var/www/html/
                                sudo cp -r /tmp/images /var/www/html/
                                sudo systemctl reload apache2
                            '

                        echo "Deployment completed successfully!"
                    '''
                }
            }
        }
    }
}